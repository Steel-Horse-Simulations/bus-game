{
  "name": "bus-game",
  "version": "1.0.0",
  "description": "",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepackage": "npm run build",
    "package": "electron-builder --dir --win",
    "installer": "electron-builder --win nsis --publish never --config electron-builder.installer.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steel-Horse-Simulations/bus-game.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Steel-Horse-Simulations/bus-game/issues"
  },
  "homepage": "https://github.com/Steel-Horse-Simulations/bus-game#readme",
  "build": {
    "appId": "com.steelhorsesimulations.busgame",
    "productName": "Bus Game",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "pipeline-data",
        "to": "pipeline-data",
        "filter": [
          "**/*",
          "!*.osm.pbf",
          "!*.log",
          "!tools/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Steel-Horse-Simulations",
      "repo": "bus-game",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^4.5.0"
  }
}
