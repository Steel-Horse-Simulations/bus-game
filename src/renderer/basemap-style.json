{
  "version": 8,
  "name": "Bus Game basemap (Phase 1 checkpoint — not the final style)",
  "glyphs": "http://127.0.0.1:38271/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://http://127.0.0.1:38271/tiles.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f2efe9" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": { "fill-color": "#cdebb0", "fill-opacity": 1 }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "paint": { "fill-color": "#e0dfdf", "fill-opacity": 1 }
    },
    {
      "id": "landuse-residential-line",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "residential"],
      "minzoom": 13,
      "paint": { "line-color": "#b9b9b9", "line-width": 0.5 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#aad3df" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#d9d0c9", "fill-opacity": 1 }
    },
    {
      "id": "building-line",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": { "line-color": "#b9a99c", "line-width": 0.75 }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": { "line-color": "#8d618b", "line-width": 1, "line-dasharray": [2, 1] }
    },

    {
      "id": "roads-track",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "track"],
      "paint": {
        "line-color": "#996600",
        "line-dasharray": [3, 2],
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          13, 0.5, 15, 1.5
        ]
      }
    },

    {
      "id": "roads-service-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "service"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 16,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 16, 4.7, 17, 8.6, 18, 10.1, 19, 12.6, 20, 13.6]
      }
    },
    {
      "id": "roads-service",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "service"],
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          14, 2, 16, 3.5, 17, 7, 18, 8.5, 19, 11, 20, 12
        ]
      }
    },

    {
      "id": "roads-minor-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "minor"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 13,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 3.5, 14, 4.1, 15, 6.2, 16, 7.2, 17, 13.6, 18, 14.6, 19, 18.6]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "minor"],
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          12, 0.5, 13, 2.5, 14, 3, 15, 5, 16, 6, 17, 12, 18, 13, 19, 17
        ]
      }
    },

    {
      "id": "roads-tertiary-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "tertiary"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 3.1, 13, 5, 14, 6.1, 15, 10.2, 16, 11.2, 17, 19.6, 18, 22.6, 19, 28.6]
      }
    },
    {
      "id": "roads-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "tertiary"],
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 0.7, 11, 0.7, 12, 2.5, 13, 4, 14, 5, 15, 9, 16, 10, 17, 18, 18, 21, 19, 27
        ]
      }
    },

    {
      "id": "roads-secondary-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "secondary"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 4.1, 13, 5.7, 14, 5.7, 15, 10.4, 16, 11.4, 17, 20, 18, 23, 19, 29]
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "secondary"],
      "paint": {
        "line-color": "#f7fabf",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          9, 1, 10, 1.1, 11, 1.1, 12, 3.5, 13, 5, 14, 5, 15, 9, 16, 10, 17, 18, 18, 21, 19, 27
        ]
      }
    },

    {
      "id": "roads-primary-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "primary"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 4.5, 13, 6, 15, 11.4, 17, 20, 18, 23, 19, 29]
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "primary"],
      "paint": {
        "line-color": "#fcd6a4",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, 1, 9, 1.4, 10, 1.8, 11, 1.8, 12, 3.5, 13, 5, 15, 10, 17, 18, 18, 21, 19, 27
        ]
      }
    },

    {
      "id": "roads-trunk-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "trunk"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 4.5, 13, 7, 15, 11.4, 17, 20, 18, 23, 19, 29]
      }
    },
    {
      "id": "roads-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "trunk"],
      "paint": {
        "line-color": "#f9b29c",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          6, 0.4, 7, 0.6, 8, 1, 9, 1.4, 10, 1.9, 11, 1.9, 12, 3.5, 13, 6, 15, 10, 17, 18, 18, 21, 19, 27
        ]
      }
    },

    {
      "id": "roads-motorway-bridge-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "motorway"], ["==", ["get", "brunnel"], "bridge"]],
      "minzoom": 12,
      "paint": {
        "line-color": "#000000",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 4.5, 13, 7, 15, 11.4, 17, 20, 18, 23, 19, 29, 20, 35]
      }
    },
    {
      "id": "roads-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": {
        "line-color": "#e892a2",
        "line-opacity": ["case", ["==", ["get", "brunnel"], "tunnel"], 0.55, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          6, 0.4, 7, 0.8, 8, 1, 9, 1.4, 10, 1.9, 11, 2,
          12, 3.5, 13, 6, 15, 10, 17, 18, 18, 21, 19, 27, 20, 33
        ]
      }
    },

    {
      "id": "roads-oneway-arrows",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["get", "oneway"], 1],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]]
      ],
      "minzoom": 15,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 75,
        "icon-image": "oneway-arrow",
        "icon-size": ["interpolate", ["linear"], ["zoom"], 15, 0.5, 18, 0.9],
        "icon-rotation-alignment": "map",
        "icon-allow-overlap": true,
        "icon-ignore-placement": true
      },
      "paint": {
        "icon-opacity": 0.55
      }
    },

    {
      "id": "roads-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          13, 9,
          17, 13
        ],
        "text-letter-spacing": 0.02,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "roads-shields",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["all", ["has", "ref"], ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]],
      "minzoom": 11,
      "layout": {
        "symbol-placement": "point",
        "symbol-spacing": 400,
        "text-field": ["get", "ref"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "icon-image": "shield-badge",
        "icon-text-fit": "both",
        "icon-text-fit-padding": [3, 5, 3, 5],
        "icon-allow-overlap": false,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#3b3b3b"
      }
    }
  ]
}
