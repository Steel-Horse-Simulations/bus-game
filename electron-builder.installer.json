{
  "appId": "com.steelhorsesimulations.busgame",
  "productName": "Bus Game",
  "asar": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "dist-electron/**"
  ],
  "extraResources": [],
  "win": {
